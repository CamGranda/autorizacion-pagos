# ---------- PostgreSQL ----------
POSTGRES_DB=pagos
POSTGRES_USER=pagos_user
POSTGRES_PASSWORD=cambiar_en_produccion
POSTGRES_PORT=5432

# ---------- RabbitMQ (notificaciones y conciliacion) ----------
RABBITMQ_USER=pagos
RABBITMQ_PASSWORD=cambiar_en_produccion
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672

# ---------- Backend (Spring Boot) ----------
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=docker

# ---------- Banco externo ----------
BANCO_URL=http://banco-externo:9000
BANCO_TOKEN=token_de_ejemplo
# Tiempo maximo de espera a la respuesta del banco (ms)
BANCO_TIMEOUT_MS=3000
# Consultas de estado antes de dar el pago por no confirmado
BANCO_CONSULTAS_MAX=3
# Fallas seguidas para abrir el circuit breaker
BANCO_CB_FALLAS=5

# ---------- Reglas de negocio ----------
# Horas que se conserva la clave de idempotencia
IDEMPOTENCIA_TTL_HORAS=24
# Cron de la conciliacion (cada 15 minutos)
CONCILIACION_CRON=0 */15 * * * *
